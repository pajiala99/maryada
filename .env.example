# Copy to .env and fill in. Never commit .env.

# --- Gnani (https://app.gnani.ai/voice) ---
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
STT_MODEL=prisma-v3.0
TTS_MODEL=timbre-v3.0
# How many Prisma streaming sessions we may hold open at once (each call uses 2).
MAX_STT_SESSIONS=4

# --- LLM judge: any OpenAI-compatible endpoint ---
# Groq:    https://api.groq.com/openai/v1            e.g. llama-3.3-70b-versatile
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai   e.g. gemini-2.0-flash
# OpenAI:  https://api.openai.com/v1
# Evon v3.3 served with vLLM: http://<host>:8000/v1  (one-line swap)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
